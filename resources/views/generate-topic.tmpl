{{ define "generate-topic.tmpl" }}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyBuddy - Tambah Topik</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }
        .mobile-container {
            max-width: 480px;
            margin: 0 auto;
            background-color: #f8fafc;
            min-height: 100vh;
            position: relative;
            padding-bottom: 90px;
        }
        .bg-brand { background-color: #02237D !important; }
        .text-brand { color: #02237D !important; }
        
        /* Timeline Custom CSS */
        .timeline {
            position: relative;
            padding-left: 20px;
            list-style: none;
        }
        /* Garis vertikal timeline */
        .timeline::before {
            content: '';
            position: absolute;
            top: 10px;
            bottom: 10px;
            left: 27px;
            width: 2px;
            background-color: #e2e8f0;
        }
        .timeline-item {
            position: relative;
            margin-bottom: 24px;
            padding-left: 25px;
            animation: fadeIn 0.5s ease-out forwards;
            opacity: 0;
            transform: translateY(10px);
        }
        /* Animasi muncul per item */
        @keyframes fadeIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .timeline-dot {
            position: absolute;
            left: 1px;
            top: 5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #cbd5e1; /* Default grey (locked) */
            z-index: 2;
        }
        .timeline-dot.active {
            background-color: #02237D;
            box-shadow: 0 0 0 4px rgba(2, 35, 125, 0.1);
        }
        
        .item-number {
            font-size: 0.75rem;
            font-weight: 700;
            color: #94a3b8;
            margin-bottom: 2px;
        }
        .item-number.active { color: #02237D; }
        
        .item-title {
            font-size: 0.95rem;
            font-weight: 500;
            color: #64748b;
        }
        .item-title.active {
            font-weight: 700;
            color: #1e293b;
        }

        /* Pulse animation untuk loader AI */
        .pulse-icon {
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { transform: scale(0.95); opacity: 0.7; }
            50% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.7; }
        }
    </style>
</head>
<body>

    <div class="mobile-container shadow-sm">
        <!-- Top Navbar -->
        <div class="d-flex align-items-center justify-content-between text-white p-3 bg-brand shadow-sm sticky-top">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-arrow-left fs-5" style="cursor: pointer;" onclick="history.back()"></i>
                <span class="fw-semibold fs-5">Tambah Topik</span>
            </div>
            <div class="bg-warning text-dark fw-bold px-3 py-1 d-flex align-items-center gap-1" style="border-radius: 20px; font-size: 0.85rem;">
                <i class="bi bi-clock"></i> 00:00
            </div>
        </div>

        <div class="container px-4 py-4 text-center">
            <!-- Header Status -->
            <div id="status-icon" class="d-inline-flex align-items-center justify-content-center bg-brand text-white rounded-4 mb-3 pulse-icon" style="width: 56px; height: 56px;">
                <i class="bi bi-cpu fs-2" id="icon-inner"></i>
            </div>
            <h4 class="fw-bold mb-2" style="color: #1a1e23;" id="status-title">AI Sedang Menyusun Materi...</h4>
            <p class="text-muted" style="font-size: 0.85rem;" id="status-desc">
                Mohon tunggu, kami sedang mengonversi input Anda menjadi rute belajar yang terstruktur.
            </p>

            <!-- Topic Info Card -->
            <div class="card border mb-4 mt-4" style="border-radius: 12px; border-color: #e2e8f0 !important;">
                <div class="card-body py-3">
                    <h6 class="fw-bold text-dark mb-1">{{ if .project }}{{ .project.Title }}{{ else }}Sedang memproses...{{ end }}</h6>
                    <p class="text-muted mb-0" style="font-size: 0.85rem;" id="subtopic-count">Memuat sub-materi...</p>
                </div>
            </div>

            <!-- List Pratinjau Rute Belajar -->
            <div class="text-start">
                <p class="fw-bold text-muted mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">PRATINJAU RUTE BELAJAR</p>
                
                <ul class="timeline m-0" id="timeline-container">
                    <!-- Item akan di-generate via JavaScript -->
                </ul>
                
                <!-- Indikator Loading AI (Muncul di bawah list saat generate) -->
                <div id="ai-typing-indicator" class="d-flex align-items-center gap-2 mt-2 ms-4 text-muted" style="font-size: 0.85rem;">
                    <div class="spinner-grow spinner-grow-sm text-brand" role="status"></div>
                    <span>AI sedang berpikir...</span>
                </div>
            </div>

            <!-- Bottom Actions (Hidden by default) -->
            <div id="action-buttons" class="mt-5 d-none fade-in">
                <button onclick="window.location.href='/materi'" class="btn w-100 text-white py-2 mb-3 bg-brand shadow-sm" style="border-radius: 8px; font-weight: 600;">
                    Mulai Belajar Sekarang &rarr;
                </button>
                <a href="/home" class="text-decoration-none fw-semibold text-brand" style="font-size: 0.9rem;">
                    Kembali ke Dashboard
                </a>
            </div>
        </div>

        <!-- Sticky Bottom Navbar -->
        <div class="fixed-bottom bg-white shadow-sm d-flex justify-content-around py-2 mx-auto" style="max-width: 480px; border-top: 1px solid #eee;">
            <div class="text-center text-secondary" style="cursor: pointer;" onclick="window.location.href='/home'">
                <i class="bi bi-grid fs-5"></i>
                <div style="font-size: 0.7rem; font-weight: 600;">Dashboard</div>
            </div>
            <div class="text-center text-secondary" style="cursor: pointer;">
                <i class="bi bi-files fs-5"></i>
                <div style="font-size: 0.7rem; font-weight: 600;">Flashcard</div>
            </div>
            <div class="text-center text-secondary" style="cursor: pointer;">
                <i class="bi bi-person-circle fs-5"></i>
                <div style="font-size: 0.7rem; font-weight: 600;">Profile</div>
            </div>
        </div>
    </div>

    <script>
        let dynamicTopics = [
            {{ range $mod := .modules }}
                "{{ $mod.Title }}",
            {{ end }}
        ];
        let createdProjectId = {{ if .project }}{{ .project.ID }}{{ else }}0{{ end }};
        let requestStatus = "{{ .requestStatus }}";
        const currentReqId = {{ if .reqID }}{{ .reqID }}{{ else }}0{{ end }};

        let currentIndex = 0;
        const container = document.getElementById('timeline-container');
        const countDisplay = document.getElementById('subtopic-count');
        const userId = "{{ if .user }}{{ .user.ID }}{{ else }}0{{ end }}";
        let isDoneFromAdmin = false;
        let ws;

        function connectWebSocket() {
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsUrl = `${protocol}//${window.location.host}/ws?user_id=${userId}&sub_topic_id=global`;
            
            ws = new WebSocket(wsUrl);
            
            ws.onmessage = function(event) {
                const data = JSON.parse(event.data);
                
                // Abaikan event dari request yang tidak sesuai (jika ini untuk generate_topic)
                if (data.req_id && data.req_id != currentReqId) return;

                if (data.type === 'generate_topic') {
                    if (data.module_title) {
                        dynamicTopics.push(data.module_title);
                        renderItem(dynamicTopics.length - 1);
                        countDisplay.textContent = `${dynamicTopics.length} Sub-materi ditambahkan...`;
                        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
                    }
                } else if (data.type === 'finish_generate_topic') {
                    isDoneFromAdmin = true;
                    if (data.project_id) {
                        createdProjectId = data.project_id;
                    }
                    finishGeneration();
                }
            };
            
            ws.onclose = function(e) {
                setTimeout(function() { connectWebSocket(); }, 1000);
            };
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Render materi yang sudah ada dari database
            for (let i = 0; i < dynamicTopics.length; i++) {
                renderItem(i);
            }
            countDisplay.textContent = `${dynamicTopics.length} Sub-materi ditambahkan...`;

            if (requestStatus === 'completed' && dynamicTopics.length > 0) {
                // Request sudah selesai dari backend
                isDoneFromAdmin = true;
                finishGeneration();
            } else {
                // Masih pending atau belum selesai, hubungkan ke WebSocket
                connectWebSocket();
            }
        });

        function renderItem(index) {
            const title = dynamicTopics[index];
            const indexNum = (index + 1).toString().padStart(2, '0');
            
            const isActive = index === 0;
            const dotClass = isActive ? "timeline-dot active" : "timeline-dot";
            const numClass = isActive ? "item-number active" : "item-number";
            const titleClass = isActive ? "item-title active" : "item-title";
            const iconHTML = isActive 
                ? `<i class="bi bi-play-circle text-brand fs-5"></i>` 
                : `<i class="bi bi-lock text-secondary fs-6"></i>`;

            const li = document.createElement('li');
            li.className = 'timeline-item d-flex justify-content-between align-items-center';
            li.innerHTML = `
                <div class="${dotClass}"></div>
                <div>
                    <div class="${numClass}">${indexNum}</div>
                    <div class="${titleClass}">${title}</div>
                </div>
                <div>
                    ${iconHTML}
                </div>
            `;
            
            container.appendChild(li);
        }

        // Hapus generateNextTopic() karena sekarang bergantung event websocket sepenuhnya


        function finishGeneration() {
            // Hilangkan loader text
            document.getElementById('ai-typing-indicator').classList.add('d-none');
            
            countDisplay.textContent = `${dynamicTopics.length} Sub-materi Perlu Dipelajari`;
            
            // Ubah Header menjadi Sukses
            const statusIcon = document.getElementById('status-icon');
            statusIcon.classList.remove('pulse-icon');
            statusIcon.innerHTML = `<i class="bi bi-check-lg fs-1"></i>`;
            
            document.getElementById('status-title').textContent = "Materi Berhasil Diunggah!";
            document.getElementById('status-desc').textContent = "AI kami telah selesai memproses materi Anda menjadi rute belajar yang terstruktur.";
            
            // Tampilkan Tombol Aksi
            document.getElementById('action-buttons').classList.remove('d-none');
            document.getElementById('action-buttons').classList.add('show');
            
            // Perbarui link tombol Mulai Belajar
            const btnMulai = document.querySelector('#action-buttons button');
            if (btnMulai && createdProjectId > 0) {
                btnMulai.setAttribute('onclick', `window.location.href='/materi?project_id=${createdProjectId}'`);
            }
            
            // Scroll sedikit ke atas agar tombol terlihat
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
{{ end }}