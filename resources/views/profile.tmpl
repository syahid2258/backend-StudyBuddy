{{ define "profile.tmpl" }}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyBuddy - Profile</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        body { 
            background-color: #f8fafc; 
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0; 
        }
        .mobile-container {
            max-width: 480px;
            margin: 0 auto;
            min-height: 100vh;
            background-color: #f8fafc;
            position: relative;
            padding-bottom: 100px;
            box-shadow: 0 0 15px rgba(0,0,0,0.05);
        }
        .bg-brand { background-color: #02237D !important; }
        .text-brand { color: #02237D !important; }
        
        /* Profile Header section */
        .profile-avatar-container {
            position: relative;
            width: 90px;
            height: 90px;
            margin: 0 auto 10px auto;
        }
        .profile-avatar {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #02237D;
            padding: 2px;
        }
        .status-badge {
            position: absolute;
            bottom: 0;
            right: 5px;
            width: 22px;
            height: 22px;
            background-color: #fbbc05; /* Warna kuning */
            border: 2px solid white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            color: white;
        }

        /* Stats Grid */
        .stat-box {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px 5px;
            text-align: center;
        }
        .stat-value {
            font-size: 1.2rem;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 2px;
        }
        .stat-label {
            font-size: 0.7rem;
            color: #64748b;
            font-weight: 600;
        }

        /* Section Title */
        .section-title {
            font-size: 1rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 12px;
            margin-top: 24px;
        }

        /* Setting Cards */
        .setting-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 14px 16px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .setting-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 2px;
        }
        .setting-desc {
            font-size: 0.8rem;
            color: #64748b;
            margin: 0;
            line-height: 1.4;
        }
        
        /* Custom Toggle Switch */
        .form-switch .form-check-input {
            width: 2.8em;
            height: 1.4em;
            cursor: pointer;
        }
        .form-check-input:checked {
            background-color: #cbd5e1;
            border-color: #cbd5e1;
        }

        /* Lainnya List (Menu) */
        .others-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            overflow: hidden;
        }
        .others-item {
            padding: 14px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e2e8f0;
            text-decoration: none;
            color: #475569;
            transition: background-color 0.2s;
            cursor: pointer;
        }
        .others-item:last-child {
            border-bottom: none;
        }
        .others-item:hover {
            background-color: #f1f5f9;
        }
        .others-item-left {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.9rem;
            font-weight: 500;
        }
        .others-item-left i {
            font-size: 1.2rem;
            color: #1e293b;
        }

        /* Logout Button */
        .btn-logout {
            border: 1.5px solid #ef4444;
            color: #ef4444;
            background-color: transparent;
            font-weight: 600;
            border-radius: 25px;
            padding: 12px;
            margin-top: 30px;
            transition: all 0.2s;
        }
        .btn-logout:hover {
            background-color: #fef2f2;
            color: #dc2626;
        }

        /* Bottom Navbar */
        .bottom-action-bar {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 480px;
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            z-index: 1020;
        }
        .nav-item {
            text-align: center;
            color: #64748b;
            cursor: pointer;
            text-decoration: none;
        }
        .nav-item.active {
            color: #02237D;
        }
        .nav-item i {
            font-size: 1.4rem;
            display: block;
            margin-bottom: 2px;
        }
        .nav-item span {
            font-size: 0.7rem;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <div class="mobile-container">
        <!-- Top Navbar -->
        <div class="d-flex align-items-center justify-content-between text-white p-3 shadow-sm bg-brand sticky-top">
            <i class="bi bi-arrow-left fs-4" style="cursor: pointer;" onclick="history.back()"></i>
            <h5 class="mb-0 fw-semibold fs-5 text-center flex-grow-1">Profile</h5>
            <div class="bg-warning text-dark fw-bold px-2 py-1 rounded-pill d-flex align-items-center gap-1" style="font-size: 0.8rem; opacity: 0;">
                <!-- Placeholder untuk menyeimbangkan padding judul (Sengaja disembunyikan agar tulisan Profile di tengah) -->
                <i class="bi bi-clock"></i> 00:00
            </div>
        </div>

        <!-- Content -->
        <div class="p-4 pt-4">
            
            <!-- User Info -->
            <div class="text-center mb-4">
                <div class="profile-avatar-container">
                    <!-- Gunakan URL gambar dummy kucing atau sesuaikan dengan sistem Anda -->
                    <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?ixlib=rb-1.2.1&auto=format&fit=crop&w=200&q=80" alt="Avatar" class="profile-avatar shadow-sm">
                    <div class="status-badge shadow-sm">
                        <i class="bi bi-stars"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-0 text-dark" style="letter-spacing: 1px;">{{ if .user.Name }}{{ .user.Name }}{{ else }}Pengguna{{ end }}</h4>
                <p class="text-muted" style="font-size: 0.9rem;">{{ if .user.Email }}{{ .user.Email }}{{ else }}-{{ end }}</p>
            </div>

            <!-- Stats -->
            <div class="row g-2 mb-2">
                <div class="col-4">
                    <div class="stat-box shadow-sm">
                        <div class="stat-value">0</div>
                        <div class="stat-label">Hari Runtuhan</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="stat-box shadow-sm">
                        <div class="stat-value">{{ if .projectCount }}{{ .projectCount }}{{ else }}0{{ end }}</div>
                        <div class="stat-label">Topik Belajar</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="stat-box shadow-sm">
                        <div class="stat-value">0</div>
                        <div class="stat-label">Jam Fokus</div>
                    </div>
                </div>
            </div>

            <!-- Pengaturan Belajar -->
            <div class="section-title">Pengaturan Belajar</div>
            
            <div class="setting-card shadow-sm">
                <div>
                    <h6 class="setting-title">Pomodoro Default</h6>
                    <p class="setting-desc">Aktifkan otomatis 25 menit fokus</p>
                </div>
                <div class="form-check form-switch m-0 p-0">
                    <input class="form-check-input ms-0 shadow-none" type="checkbox" role="switch">
                </div>
            </div>

            <div class="setting-card shadow-sm">
                <div>
                    <h6 class="setting-title">Notifikasi Review</h6>
                    <p class="setting-desc">Pengingat belajar dengan stubudy</p>
                </div>
                <div class="form-check form-switch m-0 p-0">
                    <input class="form-check-input ms-0 shadow-none" type="checkbox" role="switch">
                </div>
            </div>

            <div class="setting-card shadow-sm">
                <div class="pe-3">
                    <h6 class="setting-title">Feynman Technique</h6>
                    <p class="setting-desc">Jelaskan ulang materi dengan kata sendiri, dinilai AI</p>
                </div>
                <div class="form-check form-switch m-0 p-0">
                    <input class="form-check-input ms-0 shadow-none" type="checkbox" role="switch">
                </div>
            </div>

            <div class="setting-card shadow-sm">
                <div class="pe-3">
                    <h6 class="setting-title">Spaced Repetition</h6>
                    <p class="setting-desc">Flashcard direview ulang otomatis sesuai jadwal</p>
                </div>
                <div class="form-check form-switch m-0 p-0">
                    <input class="form-check-input ms-0 shadow-none" type="checkbox" role="switch">
                </div>
            </div>

            <!-- Lainnya -->
            <div class="section-title">Lainnya</div>
            
            <div class="others-card shadow-sm mb-4">
                <div class="others-item">
                    <div class="others-item-left">
                        <i class="bi bi-file-earmark-arrow-down"></i>
                        Unduh Rangkuman Materi
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </div>
                <div class="others-item">
                    <div class="others-item-left">
                        <i class="bi bi-translate"></i>
                        Bahasa
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </div>
                <div class="others-item">
                    <div class="others-item-left">
                        <i class="bi bi-question-circle"></i>
                        Help Center
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </div>
            </div>

            <!-- Logout Button — POST /logout to clear JWT cookie -->
            <form id="logout-form" action="/logout" method="POST" style="display:none;"></form>
            <button class="btn w-100 btn-logout shadow-sm mb-3" onclick="handleLogout()">
                <i class="bi bi-box-arrow-right me-1"></i> Keluar
            </button>

        </div>

        <!-- Sticky Bottom Navbar -->
        <div class="bottom-action-bar shadow-sm">
            <a href="/home" class="nav-item">
                <i class="bi bi-grid"></i>
                <span>Dashboard</span>
            </a>
            <a href="/flashcard" class="nav-item">
                <i class="bi bi-files"></i>
                <span>Flashcard</span>
            </a>
            <a href="/tanya-ai" class="nav-item">
                <i class="bi bi-robot"></i>
                <span>Tanya AI</span>
            </a>
            <a href="/profile" class="nav-item active">
                <i class="bi bi-person-circle"></i>
                <span>Profil</span>
            </a>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function handleLogout() {
            if (confirm('Yakin ingin keluar?')) {
                document.getElementById('logout-form').submit();
            }
        }
    </script>
</body>
</html>
{{ end }}