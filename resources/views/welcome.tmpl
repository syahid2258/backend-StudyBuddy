{{ define "welcome.tmpl" }}
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AI Edu - Belajar Cerdas, Bukan Keras</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=figtree:400,600,800&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS (CDN for rapid development/templating) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Figtree', 'sans-serif'],
                    },
                    colors: {
                        dark: '#0f172a',
                        card: '#1e293b',
                        primary: '#a855f7', // Purple
                        secondary: '#06b6d4', // Cyan
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'glow': 'glow 3s ease-in-out infinite alternate',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' },
                        },
                        glow: {
                            '0%': { boxShadow: '0 0 10px #a855f7, 0 0 20px #a855f7' },
                            '100%': { boxShadow: '0 0 20px #06b6d4, 0 0 30px #06b6d4' },
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-dark text-slate-300 font-sans antialiased overflow-x-hidden selection:bg-primary selection:text-white relative">

    <!-- Background Decoration (Glowing Orbs) -->
    <div class="fixed top-[-10%] left-[-10%] w-96 h-96 bg-primary/30 rounded-full blur-[120px] -z-10 pointer-events-none"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-96 h-96 bg-secondary/20 rounded-full blur-[120px] -z-10 pointer-events-none"></div>

    <!-- Navbar -->
    <nav class="w-full backdrop-blur-md bg-dark/50 fixed top-0 z-50 border-b border-white/10">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-secondary to-primary">
                AILearn.
            </div>
            <a href="/login" class="text-sm font-semibold hover:text-white transition-colors bg-white/10 px-4 py-2 rounded-full">Masuk</a>
        </div>
    </nav>

    <!-- 1. HERO SECTION -->
    <header class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 flex flex-col items-center justify-center text-center px-6 min-h-[90vh]">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-semibold text-secondary mb-6 backdrop-blur-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-secondary"></span>
            </span>
            Goravel {{ .version }} Engine Ready
        </div>
        
        <h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight mb-6 leading-tight">
            Belajar <span class="text-transparent bg-clip-text bg-gradient-to-r from-secondary to-primary">Cerdas</span>,<br> Bukan Keras.
        </h1>
        
        <p class="max-w-2xl text-lg lg:text-xl text-slate-400 mb-10 leading-relaxed">
            Tinggalkan cara lama. Biarkan AI merancang rute belajarmu, membedah materi rumit, dan memastikan ilmu benar-benar nempel di otak, bukan sekadar dihafal.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
            <button class="animate-glow px-8 py-4 rounded-full bg-primary text-white font-bold text-lg hover:bg-purple-500 transition-all transform hover:scale-105 shadow-lg">
                Mulai Belajar Gratis 🚀
            </button>
            <button class="px-8 py-4 rounded-full bg-white/5 border border-white/10 text-white font-bold text-lg hover:bg-white/10 transition-all backdrop-blur-md">
                Lihat Demo
            </button>
        </div>
    </header>

    <!-- 2. HOW IT WORKS -->
    <section class="py-20 bg-card/30 border-y border-white/5">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">Cara Kerja AI Kami</h2>
                <p class="text-slate-400">Tiga langkah simpel menuju pemahaman tingkat dewa.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Step 1 -->
                <div class="relative p-8 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:-translate-y-2 transition-transform duration-300 group">
                    <div class="absolute -top-4 -right-4 text-6xl opacity-20 font-extrabold text-white group-hover:text-secondary transition-colors">01</div>
                    <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-secondary rounded-xl flex items-center justify-center mb-6 text-2xl shadow-lg">📤</div>
                    <h3 class="text-xl font-bold text-white mb-3">Upload Materi</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Punya PDF tebal atau slide presentasi dosen? Upload saja. AI akan membaca dan mengekstrak poin-poin krusial dalam hitungan detik.</p>
                </div>
                <!-- Step 2 -->
                <div class="relative p-8 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:-translate-y-2 transition-transform duration-300 group">
                    <div class="absolute -top-4 -right-4 text-6xl opacity-20 font-extrabold text-white group-hover:text-primary transition-colors">02</div>
                    <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-primary rounded-xl flex items-center justify-center mb-6 text-2xl shadow-lg">🧠</div>
                    <h3 class="text-xl font-bold text-white mb-3">AI Buat Rute Belajar</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">AI akan memecah materi menjadi "Bite-sized learning" atau potongan kecil yang mudah dicerna, lengkap dengan alur logika penyelesaian.</p>
                </div>
                <!-- Step 3 -->
                <div class="relative p-8 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:-translate-y-2 transition-transform duration-300 group">
                    <div class="absolute -top-4 -right-4 text-6xl opacity-20 font-extrabold text-white group-hover:text-green-400 transition-colors">03</div>
                    <div class="w-14 h-14 bg-gradient-to-br from-emerald-400 to-green-600 rounded-xl flex items-center justify-center mb-6 text-2xl shadow-lg">🎯</div>
                    <h3 class="text-xl font-bold text-white mb-3">Evaluasi & Ujian</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Uji pemahamanmu dengan kuis interaktif yang di-generate otomatis. AI akan melacak bagian mana yang kamu masih lemah.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. THE METHODS (Fitur Unggulan) -->
    <section class="py-24 relative">
        <div class="max-w-7xl mx-auto px-6">
            <h2 class="text-3xl lg:text-4xl font-bold text-white mb-12 text-center">Metode <span class="text-primary">Anti-Lupa</span></h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Method 1: Feynman -->
                <div class="group p-6 rounded-2xl bg-gradient-to-b from-card to-dark border border-white/10 hover:border-secondary/50 transition-colors">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="p-3 bg-secondary/20 text-secondary rounded-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
                        </div>
                        <h3 class="text-lg font-bold text-white group-hover:text-secondary transition-colors">Feynman Technique</h3>
                    </div>
                    <p class="text-slate-400 text-sm">Cobalah "mengajar" AI lewat input suara/teks. AI akan mengoreksi jika bahasamu terlalu rumit atau ada konsep yang meleset.</p>
                </div>

                <!-- Method 2: Pomodoro -->
                <div class="group p-6 rounded-2xl bg-gradient-to-b from-card to-dark border border-white/10 hover:border-primary/50 transition-colors">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="p-3 bg-primary/20 text-primary rounded-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <h3 class="text-lg font-bold text-white group-hover:text-primary transition-colors">Smart Pomodoro</h3>
                    </div>
                    <p class="text-slate-400 text-sm">Sistem akan otomatis mengatur sesi fokus 25 menit. Saat istirahat, layar belajar akan terkunci agar matamu benar-benar rehat.</p>
                </div>

                <!-- Method 3: Spaced Repetition -->
                <div class="group p-6 rounded-2xl bg-gradient-to-b from-card to-dark border border-white/10 hover:border-pink-500/50 transition-colors">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="p-3 bg-pink-500/20 text-pink-400 rounded-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                        </div>
                        <h3 class="text-lg font-bold text-white group-hover:text-pink-400 transition-colors">Spaced Repetition</h3>
                    </div>
                    <p class="text-slate-400 text-sm">AI mengubah catatanmu menjadi Flashcard. Algoritma kami tahu kapan ingatanmu mulai pudar dan akan memunculkan materi itu lagi.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. TESTIMONIALS -->
    <section class="py-20 bg-gradient-to-t from-dark to-card/50">
        <div class="max-w-5xl mx-auto px-6">
            <h2 class="text-3xl font-bold text-center text-white mb-12">Kata Mereka yang Sudah "Cerdas"</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Testi 1 -->
                <div class="p-8 rounded-3xl bg-white/5 border border-white/10 relative">
                    <div class="text-primary text-4xl absolute top-6 right-8 opacity-50">"</div>
                    <p class="text-slate-300 italic mb-6 relative z-10">
                        "Dulu baca jurnal atau buku IT tebal rasanya mau muntah. Lewat AILearn, materi Sistem Operasi dipecah jadi analogi restoran. Gila sih, langsung paham konsep deadlock!"
                    </p>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-r from-secondary to-blue-500 flex items-center justify-center font-bold text-white">R</div>
                        <div>
                            <h4 class="text-white font-semibold text-sm">Rizky, Mahasiswa Informatika</h4>
                            <span class="text-xs text-slate-500">GPA 3.8</span>
                        </div>
                    </div>
                </div>

                <!-- Testi 2 -->
                <div class="p-8 rounded-3xl bg-white/5 border border-white/10 relative">
                    <div class="text-secondary text-4xl absolute top-6 right-8 opacity-50">"</div>
                    <p class="text-slate-300 italic mb-6 relative z-10">
                        "Flashcard spaced repetition-nya juara. Menjelang UAS Fisika Dasar nggak perlu SKS (Sistem Kebut Semalam) lagi karena ingatan udah terawat tiap hari."
                    </p>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-r from-primary to-pink-500 flex items-center justify-center font-bold text-white">N</div>
                        <div>
                            <h4 class="text-white font-semibold text-sm">Nadia, Mahasiswa Teknik</h4>
                            <span class="text-xs text-slate-500">Lulus Ujian 95/100</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/10 py-8 mt-10">
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500">
            <div>&copy; 2026 AILearn Platform. Built with Goravel.</div>
            <div class="flex gap-4">
                <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
                <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
            </div>
        </div>
    </footer>

</body>
</html>
{{ end }}