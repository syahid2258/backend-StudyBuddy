APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stubydu
DB_USERNAME=root
DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

# Konfigurasi Gemini API (AI Layer) — dapatkan API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional: isi ini untuk multi-key auto-rotate + failover (dari beberapa akun
# berbeda, comma-separated). Kalau diisi, GEMINI_API_KEY di atas diabaikan.
# Contoh: GEMINI_API_KEYS=AIzaSy_key_akun_1,AIzaSy_key_akun_2,AIzaSy_key_akun_3
GEMINI_API_KEYS=
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=60

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
